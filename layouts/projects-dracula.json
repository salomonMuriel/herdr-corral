{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    14,
    14
  ],
  "theme": "dracula",
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 336
      },
      "min": 260,
      "max": 520,
      "background": "chrome",
      "children": [
        {
          "id": "head",
          "type": "block",
          "size": {
            "px": 40
          },
          "window_drag": true,
          "content": {
            "mod": "projects",
            "props": {
              "view": "head",
              "skin": "dracula"
            }
          }
        },
        {
          "id": "sessions",
          "type": "block",
          "content": {
            "mod": "projects",
            "props": {
              "view": "sidebar",
              "skin": "dracula"
            }
          }
        }
      ]
    },
    {
      "id": "main-column",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "bar",
          "type": "block",
          "size": {
            "px": 40
          },
          "window_drag": true,
          "content": {
            "mod": "projects",
            "props": {
              "view": "bar",
              "skin": "dracula"
            }
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "view",
              "type": "stack",
              "active": "work",
              "children": [
                {
                  "id": "work",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 8,
                      "radius": 6,
                      "background": "background",
                      "lone": true,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "height": 28,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  }
                },
                {
                  "id": "board",
                  "type": "block",
                  "content": {
                    "mod": "projects",
                    "props": {
                      "view": "board",
                      "skin": "dracula"
                    }
                  }
                }
              ]
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 26
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ],
  "ui_font": "Geist",
  "font": "JetBrains Mono",
  "font_size": 14
}