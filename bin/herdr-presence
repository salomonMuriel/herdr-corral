#!/usr/bin/env python3
"""herdr-presence: whether the person is at this machine's Herdr window, as JSON.

  {"window": "active" | "inactive" | "closed", "idle_seconds": 12.5 | null}

The projects mod writes the window file every 30 s while the window is open, so an older
file means the window is closed. herdr-pi asks each machine over ssh before a phone alert.
"""

from __future__ import annotations

import ctypes
import json
import os
import subprocess
import sys
import time
from pathlib import Path
from typing import Optional

WINDOW_FILE = Path.home() / ".cache/herdr-corral/window.json"
WINDOW_STALE_SECONDS = 90


def window_state() -> str:
    try:
        saved = json.loads(WINDOW_FILE.read_text())
    except (OSError, ValueError):
        return "closed"
    age = time.time() - saved.get("at_ms", 0) / 1000
    if age > WINDOW_STALE_SECONDS:
        return "closed"
    return "active" if saved.get("active") else "inactive"


def macos_idle_seconds() -> Optional[float]:
    output = subprocess.run(["ioreg", "-c", "IOHIDSystem", "-d", "4"], capture_output=True, text=True, timeout=10).stdout
    for line in output.splitlines():
        if "HIDIdleTime" in line:
            return int(line.rsplit("=", 1)[1].strip()) / 1e9
    return None


class ScreenSaverInfo(ctypes.Structure):
    _fields_ = [
        ("window", ctypes.c_ulong),
        ("state", ctypes.c_int),
        ("kind", ctypes.c_int),
        ("til_or_since", ctypes.c_ulong),
        ("idle", ctypes.c_ulong),
        ("event_mask", ctypes.c_ulong),
    ]


def x11_idle_seconds() -> Optional[float]:
    x11 = ctypes.cdll.LoadLibrary("libX11.so.6")
    xss = ctypes.cdll.LoadLibrary("libXss.so.1")
    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
    x11.XDefaultRootWindow.restype = ctypes.c_ulong
    x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
    xss.XScreenSaverAllocInfo.restype = ctypes.POINTER(ScreenSaverInfo)
    xss.XScreenSaverQueryInfo.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(ScreenSaverInfo)]
    os.environ.setdefault("XAUTHORITY", str(Path.home() / ".Xauthority"))
    display = x11.XOpenDisplay(os.environ.get("DISPLAY", ":0").encode())
    if not display:
        return None
    try:
        info = xss.XScreenSaverAllocInfo()
        if not xss.XScreenSaverQueryInfo(display, x11.XDefaultRootWindow(display), info):
            return None
        return info.contents.idle / 1000
    finally:
        x11.XCloseDisplay(display)


def idle_seconds() -> Optional[float]:
    try:
        if sys.platform == "darwin":
            return macos_idle_seconds()
        return x11_idle_seconds()
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"herdr-presence: no idle time: {error}", file=sys.stderr)
        return None


def main() -> None:
    print(json.dumps({"window": window_state(), "idle_seconds": idle_seconds()}))


if __name__ == "__main__":
    main()
